<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Exp_03_AndroidWidgets" parent="android:Theme.Material.Light">
        <item name="android:colorPrimary">@color/lab_surface</item>
        <item name="android:colorPrimaryDark">@color/lab_surface</item>
        <item name="android:colorAccent">@color/lab_accent</item>
        <item name="android:windowBackground">@color/lab_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:actionModeBackground">@color/lab_selected</item>
    </style>

    <style name="LabEntry" parent="android:Widget.Material.Light.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:backgroundTint">@color/lab_tint</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/lab_ink</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
